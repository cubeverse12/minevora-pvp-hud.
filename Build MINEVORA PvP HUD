
name: Build MINEVORA PvP HUD

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Pobierz kod
        uses: actions/checkout@v4

      - name: Zainstaluj Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Przygotuj Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.12'

      - name: Zbuduj mod
        run: gradle --no-daemon build

      - name: Udostepnij JAR
        uses: actions/upload-artifact@v4
        with:
          name: MINEVORA-PVP-HUD
          path: build/libs/*.jar
          if-no-files-found: error
